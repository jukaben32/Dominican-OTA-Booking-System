# =====================================================================
# Variables de entorno. Copia este archivo a ".env.local" y reemplaza
# cada <...> por tu valor real. NUNCA subas .env.local a git.
# =====================================================================

# --- Supabase (proyecto PROPIO de esta agencia; no uses el de otros proyectos) ---
NEXT_PUBLIC_SUPABASE_URL=<https://tu-proyecto.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<llave anon>
# Llave de servicio: salta la seguridad. SOLO en el servidor, jamás con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<llave service_role>

# --- WhatsApp oficial vía YCloud ---
YCLOUD_API_KEY=<llave de API de YCloud>
YCLOUD_WEBHOOK_SECRET=<secreto del webhook que muestra YCloud>
# Número de WhatsApp Business emisor, formato internacional con +
WHATSAPP_FROM_NUMBER=<+1809XXXXXXX>

# --- Seguridad propia (genera valores largos y aleatorios, mínimo 16 caracteres) ---
# Firma del webhook de pagos (el adaptador de la pasarela firma con este secreto)
PAYMENT_WEBHOOK_SECRET=<texto aleatorio largo>
# Vercel Cron lo manda como "Authorization: Bearer <valor>"
CRON_SECRET=<texto aleatorio largo>

# --- Público (se muestra en la web) ---
# Número para el botón de WhatsApp de la landing, solo dígitos y código de país
NEXT_PUBLIC_WHATSAPP_NUMBER=<1809XXXXXXX>
# Número de licencia/RUT del MITUR. Déjalo vacío hasta tenerlo: la web dirá "en trámite"
NEXT_PUBLIC_MITUR_RUT=

# --- Reserva en línea sin agente ---
# Secreto para calcular el enlace privado de cada cliente (mínimo 32 caracteres, aleatorio). Si cambia, los enlaces ya entregados dejan de funcionar
ONLINE_LINK_SECRET=<texto aleatorio de 32+ caracteres>
# Datos para transferir (banco, tipo y número de cuenta, titular, RNC). Texto simple, hasta 800 caracteres
BANK_TRANSFER_INSTRUCTIONS=<Banco ... / Cuenta corriente ... / Titular ...>

# --- Pago con tarjeta: Página de Pago de Azul (opcional; sin estas variables no se ofrece tarjeta) ---
# Datos que te da Azul al afiliar tu comercio. Empieza SIEMPRE en "test" con las credenciales de pruebas.
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=
AZUL_AUTH_KEY=
AZUL_ENVIRONMENT=test
# Código de moneda: "$" = pesos dominicanos. Dólares solo si Azul los habilitó (pregúntales el valor exacto)
AZUL_CURRENCY_CODE_DOP=$
AZUL_CURRENCY_CODE_USD=
# Dirección pública de la web, adonde Azul devuelve al cliente (en producción debe ser https)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
